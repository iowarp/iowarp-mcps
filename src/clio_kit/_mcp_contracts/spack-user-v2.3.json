        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Install one Spack spec with explicit reusable or fresh concretization. Runs synchronously (streaming/task augmentation is deferred to the kit tasks-semantics slice, SEP-2663) with a configurable timeout; captures the full build log to disk and returns its path plus a bounded tail, and the install prefix on success. A missing recipe, a failed build, and a timeout are distinct typed errors (recipe_not_found / build_failure / timed_out), each naming the recovery affordance (searched repos / log tail / log path).",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "reuse": {
            "default": true,
            "description": "Choose Spack concretization explicitly: true passes --reuse and may reuse compatible installed packages or buildcaches; false passes --fresh and excludes them while concretizing.",
            "type": "boolean"
          },
          "spec": {
            "type": "string"
          },
          "timeout_seconds": {
            "default": 14400,
            "type": "integer"
          }
        },
        "required": [
          "spec"
        ],
        "type": "object"
      },
      "name": "spack_install",
      "outputSchema": {
        "additionalProperties": false,
        "description": "Completed Spack install: full log on disk, tail inline, real prefix.",
        "properties": {
          "duration_seconds": {
            "type": "number"
          },
          "load_spec": {
            "description": "Exact runtime identity for JARVIS. Copy this value unchanged from spack_install.output.load_spec into one element of jarvis_run.input.spack_specs.",
            "type": "string"
          },
          "log_path": {
            "description": "Full build log on disk, unbounded by the MCP response.",
            "type": "string"
          },
          "log_tail": {
            "description": "Bounded tail of the build log for inline review.",
            "type": "string"
          },
          "operation": {
            "const": "install",
            "default": "install",
            "type": "string"
