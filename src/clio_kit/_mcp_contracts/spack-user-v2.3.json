    {
      "_meta": {
        "fastmcp": {
          "tags": [
            "packages",
            "spack",
            "user"
          ]
        }
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Search recipe AVAILABILITY across every registered Spack repo -- broader than spack_find/spack_locate, which only see what is already installed. Answers 'does a recipe exist', 'in which repo', and 'is it already installed' in one call. No matches is a successful result with count=0.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "name": "spack_search",
      "outputSchema": {
        "additionalProperties": false,
        "description": "Recipe availability across every registered repo, not just installs.",
        "properties": {
          "count": {
            "type": "integer"
          },
          "installed_state_degraded": {
            "default": false,
            "description": "True when `spack find` failed while resolving install state; recipe availability above is still authoritative, but every match's installed/installed_packages defaults to not-installed rather than a confirmed answer.",
            "type": "boolean"
          },
          "installed_state_degraded_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "matches": {
            "items": {
              "additionalProperties": false,
              "description": "One catalog recipe matched by a search query.",
              "properties": {
                "installed": {
                  "type": "boolean"
                },
                "installed_packages": {
                  "items": {
                    "additionalProperties": false,
                    "description": "Stable summary of one concrete installed Spack package.",
                    "properties": {
                      "architecture": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "default": null
                      },
                      "compiler": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "default": null
                      },
                      "dag_hash": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "default": null
                      },
                      "name": {
                        "type": "string"
                      },
                      "version": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "default": null
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "name": {
                  "type": "string"
                },
                "repos": {
                  "description": "Registered repo namespaces that declare this recipe.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "name",
                "repos",
                "installed"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "operation": {
            "const": "search",
            "default": "search",
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "repos_searched": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "repos_unreadable": {
            "description": "Registered repos whose package directory could not be scanned (missing path, permission denied, ...); recipes may exist there that this search could not see. Never treat an empty result as a confirmed absence when this list is non-empty.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "schema_version": {
            "const": "spack.mcp.result.v1",
            "default": "spack.mcp.result.v1",
            "type": "string"
          },
          "total_matches": {
            "description": "Total ranked matches before the response cap; compare with count/truncated to tell '25 of 25' from '25 of 60'.",
            "type": "integer"
          },
          "truncated": {
            "default": false,
            "description": "True when total_matches exceeds the 25-result cap.",
            "type": "boolean"
          }
        },
        "required": [
          "query",
          "repos_searched",
          "matches",
          "count",
          "total_matches"
        ],
        "type": "object"
      },
      "title": "Search Recipes"
